{
  "name": "replicate-games",
  "version": "1.0.0",
  "private": true,
  "description": "Typed, provably-fair workspace for the Replicate Games catalogue",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm clubs:dev",
    "demo:dev": "pnpm --parallel --filter @replicate/web --filter @replicate/server demo:dev",
    "clubs:db:up": "docker compose -f compose.clubs.yml up -d --wait",
    "clubs:db:down": "docker compose -f compose.clubs.yml down",
    "clubs:db:migrate": "pnpm --filter @replicate/server db:migrate:clubs",
    "clubs:local:seed": "pnpm --filter @replicate/server local:seed",
    "clubs:setup": "pnpm clubs:db:up && pnpm clubs:db:migrate",
    "clubs:dev": "pnpm clubs:setup && pnpm --parallel --filter @replicate/web --filter @replicate/server dev:clubs",
    "start": "pnpm build:web && pnpm --filter @replicate/server start",
    "build": "pnpm build:web && pnpm typecheck",
    "build:web": "pnpm --filter @replicate/web build",
    "typecheck": "tsc -p tsconfig.json --pretty",
    "typecheck:watch": "tsc -p tsconfig.json --watch --pretty",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm build:web && node scripts/test-workspace.mjs",
    "test:postgres": "pnpm build:web && node scripts/test-postgres.mjs",
    "test:gaming": "node --import tsx --test packages/operator-protocol/test/*.test.ts packages/operator-sdk/test/*.test.ts apps/gaming-rgs/test/*.test.ts apps/operator-sandbox/test/*.test.ts",
    "test:workspace": "pnpm test && pnpm --filter leapbound exec vitest run --testTimeout=30000",
    "test:e2e": "playwright test",
    "test:e2e:gaming": "pnpm --filter @rounder/gaming-client build && playwright test --config playwright.gaming.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "covers:build": "node scripts/build-catalog-covers.mjs",
    "midas:videos": "node scripts/build-midas-actor-videos.mjs",
    "audit:rtp": "node scripts/gates-rtp-audit.mjs --spins=1000000 --double-spins=100000 --bonus-packs=20000",
    "audit:slots:inventory": "node scripts/slot-audit-inventory.mjs",
    "audit:slots:mechanics": "node scripts/audit-slot-purchases.mjs",
    "audit:slots:browser": "node scripts/audit-slots-browser.mjs",
    "audit:slots:purchases": "node scripts/audit-slot-purchases-browser.mjs",
    "audit:slots:audio": "node scripts/audit-slots-audio.mjs",
    "audit:slots:settings": "node scripts/audit-slot-settings.mjs",
    "audit:slots:standalone": "node scripts/audit-standalone-slots.mjs && node scripts/audit-standalone-actions.mjs && node scripts/audit-standalone-mobile.mjs",
    "audit:jaws:responsive": "node scripts/audit-jaws-responsive.mjs",
    "audit:slots:report": "node scripts/slot-audit-report.mjs && node scripts/standalone-audit-report.mjs",
    "db:migrate": "pnpm --filter @replicate/server db:migrate",
    "gaming:dev": "pnpm --parallel --filter @rounder/gaming-client --filter @rounder/gaming-rgs --filter @rounder/operator-sandbox dev",
    "gaming:build": "pnpm --filter @rounder/gaming-client build && pnpm --filter @rounder/gaming-rgs typecheck && pnpm --filter @rounder/operator-sandbox typecheck",
    "gaming:release:verify": "pnpm --filter @rounder/gaming-client build && pnpm --filter @rounder/gaming-rgs release:verify",
    "gaming:db:migrate": "pnpm --filter @rounder/gaming-rgs db:migrate",
    "gaming:operator:bootstrap": "pnpm --filter @rounder/gaming-rgs operator:bootstrap",
    "showcase:registry": "node --import tsx scripts/generate-showcase-registry.mjs",
    "showcase:registry:check": "node --import tsx scripts/generate-showcase-registry.mjs --check",
    "showcase:dev": "pnpm showcase:registry && node --import tsx scripts/prepare-showcase-public.mjs && pnpm --filter @rounder/gaming-showcase dev",
    "showcase:build": "pnpm showcase:registry && node --import tsx scripts/prepare-showcase-public.mjs && pnpm --filter @rounder/gaming-showcase build && node --import tsx scripts/publish-showcase-assets.mjs",
    "showcase:test": "pnpm showcase:registry:check && node --import tsx --test apps/gaming-showcase/test/*.test.ts",
    "showcase:test:e2e": "pnpm showcase:build && playwright test --config playwright.showcase.config.ts",
    "showcase:deploy": "./infra/deploy-showcase.sh",
    "fireblocks:check": "pnpm --filter @replicate/server fireblocks:check",
    "fireblocks:bootstrap": "pnpm --filter @replicate/server fireblocks:bootstrap",
    "club-payouts:run": "pnpm --filter @replicate/server club-payouts:run",
    "club-payouts:reconcile": "pnpm --filter @replicate/server club-payouts:reconcile",
    "settlement:close": "pnpm --filter @replicate/server settlement:close",
    "analytics:rollup": "pnpm --filter @replicate/server analytics:rollup",
    "audit:odins-vault": "node --import tsx scripts/odins-vault-rtp-audit.mjs",
    "audit:fairness": "node --import tsx scripts/fairness-rtp-audit.mjs",
    "audit:finite": "node --import tsx scripts/finite-house-edge-audit.mjs",
    "audit:slots": "node scripts/slots-rtp-audit.mjs --strict=true",
    "audit:banana-farm": "node scripts/banana-farm-rtp-audit.mjs --output=banana-farm/evidence/rtp-audit.json",
    "audit:witch-blood": "node --import tsx scripts/audit-witch-blood-math.mjs",
    "capture:neon-pinball": "node scripts/capture-neon-pinball-motion.mjs",
    "capture:xmas-drop": "node scripts/capture-xmas-drop-evidence.mjs",
    "compare:neon-pinball": "node scripts/compare-neon-pinball-motion.mjs",
    "audit:slots:resolutions": "node scripts/audit-slot-resolutions.mjs && node scripts/audit-jaws-responsive.mjs",
    "audit:slots:loading": "node scripts/audit-slot-fresh-loads.mjs",
    "audit:slots:mobile-spins": "node scripts/audit-slot-mobile-spins.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@replicate/contracts": "workspace:*",
    "@replicate/game-registry": "workspace:*",
    "@rounder/game-runtime-contracts": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/three": "^0.180.0",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.2.8",
    "sharp": "^0.34.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
